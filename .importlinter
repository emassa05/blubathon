[importlinter]
root_packages =
    apps
    ml
    packages
    tools
include_external_packages = True

# CONVENTIONS 4. A comment does not enforce a boundary; these contracts do.
# The `rag` contracts are added with the package in M4.

[importlinter:contract:shared-is-independent]
name = The shared contract depends on nobody
type = forbidden
source_modules =
    packages
forbidden_modules =
    apps
    ml
    fastapi
    sqlite3
    lightgbm
    sklearn

[importlinter:contract:ml-does-not-import-apps]
name = Pure ML domain does not import application code
type = forbidden
source_modules =
    ml
forbidden_modules =
    apps
    fastapi
    uvicorn
    sqlite3

[importlinter:contract:store-does-not-compute]
name = The store persists; it does not compute defaults, VoI or risk
type = forbidden
source_modules =
    apps.api.store
# `apps/api -> ml` is an allowed dependency, so this names the computation
# modules rather than all of `ml`: an error taxonomy or a versioned adapter is
# not a calculation. The list grows with `ml/defaults`, `ml/form` and
# `ml/prediction` in M2.
forbidden_modules =
    ml.engine
    ml.eval
    ml.features
    ml.voi

[importlinter:contract:layers]
name = Application above domain above contract
type = layers
layers =
    apps
    ml
    packages
