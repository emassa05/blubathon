{
  "name": "@blubathon/mobile",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Interfaz visual de Blubathon (Vue 3 + Vite). Pantalla Salud.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blubathon/contract": "workspace:*",
    "@fontsource/nunito": "5.3.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "22.13.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.13.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
